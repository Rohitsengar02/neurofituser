<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/nf_bg_light" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/nf_bubble" android:gravity="center"
            android:text="N" android:textColor="#FFFFFFFF" android:textSize="11sp" android:fontFamily="sans-serif-black"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="Today" android:textColor="#FF111827" android:textSize="16sp" android:fontFamily="sans-serif-black"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/nf_chip_soft"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="Thu, 26 Nov" android:textColor="#FF7C3AED" android:textSize="10.5sp" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/col1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                <ImageView android:id="@+id/ring1" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:text="👟" android:textSize="17sp"/>
            </FrameLayout>
            <TextView android:id="@+id/val1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="8,542" android:textColor="#FF111827" android:textSize="14sp" android:fontFamily="sans-serif-black" android:maxLines="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Steps" android:textColor="#FF6B7280" android:textSize="10sp" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/col2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                <ImageView android:id="@+id/ring2" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:text="🔥" android:textSize="17sp"/>
            </FrameLayout>
            <TextView android:id="@+id/val2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="1,420" android:textColor="#FF111827" android:textSize="14sp" android:fontFamily="sans-serif-black" android:maxLines="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="kcal" android:textColor="#FF6B7280" android:textSize="10sp" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/col3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                <ImageView android:id="@+id/ring3" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:text="💧" android:textSize="17sp"/>
            </FrameLayout>
            <TextView android:id="@+id/val3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="1.3 L" android:textColor="#FF111827" android:textSize="14sp" android:fontFamily="sans-serif-black" android:maxLines="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Water" android:textColor="#FF6B7280" android:textSize="10sp" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/col4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                <ImageView android:id="@+id/ring4" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:text="🌙" android:textSize="17sp"/>
            </FrameLayout>
            <TextView android:id="@+id/val4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="7h 20m" android:textColor="#FF111827" android:textSize="14sp" android:fontFamily="sans-serif-black" android:maxLines="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sleep" android:textColor="#FF6B7280" android:textSize="10sp" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
<ViewFlipper android:id="@+id/flip" android:layout_width="match_parent" android:layout_height="wrap_content" android:autoStart="true" android:flipInterval="3800" android:inAnimation="@anim/nf_in" android:outAnimation="@anim/nf_out">
    <TextView android:id="@+id/flip_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF6B7280" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:text="You're 85% to your step goal"/>
    <TextView android:id="@+id/flip_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF6B7280" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:text="You're 85% to your step goal"/>
    <TextView android:id="@+id/flip_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF6B7280" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:text="You're 85% to your step goal"/>
</ViewFlipper>
</LinearLayout>
