{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/privacy",
      "dest": "/privacy/index.html"
    },
    {
      "src": "/privacy/",
      "dest": "/privacy/index.html"
    },
    {
      "src": "/terms",
      "dest": "/terms/index.html"
    },
    {
      "src": "/terms/",
      "dest": "/terms/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}